---
import Icon from './Icon.astro';
interface Props {
  class?: string;
  href?: string;
}
const { class: className = '', href = '/book-online/' } = Astro.props;
---

<a class={`button booking-button ${className}`} href={href}>
  <Icon name="calendar" size={21} /> <span>Book an Ultrasound</span>
</a>
