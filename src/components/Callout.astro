---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="callout">
  <div class="container callout-inner">
    <div class="callout-symbol">
      <Icon name="scan" size={72} />
    </div>
    <div>
      <p class="section-label">Experienced hands. Personal care.</p>
      <h2>Let’s take the next step.</h2>
      <p>
        Book your ultrasound online, or call reception
        <br class="desktop-only" /> for a little guidance with your referral.
      </p>
    </div>
    <div class="callout-actions">
      <a class="button button-gold" href="/book-online/">
        <Icon name="calendar" size={22} /> Book an ultrasound
      </a>
      <a href={site.tel} data-event="phone_click">
        <Icon name="phone" size={19} /> {site.phone}
      </a>
    </div>
  </div>
</section>
