---
import BookingButton from './BookingButton.astro';
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="callout">
  <div class="container callout-inner">
    <div>
      <p class="section-label">Experienced hands. Personal care.</p>
      <h2>Book your ultrasound.</h2>
      <p>
        Book your ultrasound online or call reception for guidance with your
        referral.
      </p>
    </div>
    <div class="callout-actions">
      <BookingButton />
      <a href={site.tel} data-event="phone_click">
        <Icon name="phone" size={19} /> {site.phone}
      </a>
    </div>
  </div>
</section>
