---
import { Image } from 'astro:assets';
import { images } from '../data/images';
import { site } from '../data/site';
import Icon from './Icon.astro';
const links = [
  ['Services', '/services/'],
  ['Patient information', '/patient-information/'],
  ['Pricing', '/pricing/'],
  ['About us', '/about/'],
  ['Referrers', '/referrers/'],
  ['Contact', '/contact/'],
];
const current = Astro.url.pathname;
---

<div class="utility">
  <div class="container utility-inner">
    <span>
      <Icon name="pin" size={15} /> Hobsonville, Auckland{' '}
      <span class="utility-parking">· Free visitor parking</span>
    </span>
    <a href={site.tel} data-event="phone_click">
      <Icon name="phone" size={15} /> {site.phone}
    </a>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Hobsonville Ultrasound home">
      <Image
        src={images.logo}
        alt="Hobsonville Ultrasound"
        width={320}
        format="webp"
        loading="eager"
      />
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map(([label, href]) => (
        <a
          href={href}
          aria-current={current.startsWith(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <a class="button button-small header-book" href="/book-online/">
      <Icon name="calendar" size={18} /> Book a scan
    </a>
    <details class="mobile-menu">
      <summary>
        Menu <Icon name="menu" size={20} />
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map(([label, href]) => (
          <a
            href={href}
            aria-current={current.startsWith(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
        <a href="/book-online/">Book a scan ↗</a>
      </nav>
    </details>
  </div>
</header>
