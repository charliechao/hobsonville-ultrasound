---
import { Image } from 'astro:assets';
import { images } from '../data/images';
import { site } from '../data/site';
import Icon from './Icon.astro';
import BookingButton from './BookingButton.astro';
const links = [
  ['Home', '/'],
  ['Services', '/services/'],
  ['Patient information', '/patient-information/'],
  ['Pricing', '/pricing/'],
  ['About us', '/about/'],
  ['Blog', '/blog/'],
  ['Referrers', '/referrers/'],
  ['Contact', '/contact/'],
];
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const current =
  base && (pathname === base || pathname.startsWith(base + '/'))
    ? pathname.slice(base.length) || '/'
    : pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<div class="utility">
  <div class="container utility-inner">
    <span>
      <Icon name="pin" size={15} /> Hobsonville, Auckland{' '}
      <span class="utility-parking">· Free visitor parking</span>
    </span>
    <a href={site.tel} data-event="phone_click">
      <Icon name="phone" size={15} /> {site.phone}
    </a>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Hobsonville Ultrasound home">
      <Image
        src={images.logo}
        alt="Hobsonville Ultrasound"
        width={320}
        format="webp"
        loading="eager"
      />
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map(([label, href]) => (
        <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <BookingButton class="header-book" />
    <details class="mobile-menu">
      <summary>
        Menu <Icon name="menu" size={20} />
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map(([label, href]) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))}
        <BookingButton />
      </nav>
    </details>
  </div>
</header>
