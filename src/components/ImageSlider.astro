---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
interface Props {
  id: string;
  label: string;
  slides: { image: ImageMetadata; alt: string; caption: string }[];
  hero?: boolean;
  autoplay?: boolean;
}
const { id, label, slides, hero = false, autoplay = false } = Astro.props;
---

<image-slider
  id={id}
  class:list={['image-slider', { 'hero-slider': hero }]}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-autoplay={autoplay ? 'true' : 'false'}
>
  <div class="slider-frames" id={`${id}-frames`}>
    {slides.map((slide, i) => (
      <figure
        class:list={['slider-frame', { 'is-active': i === 0 }]}
        data-slide
        aria-hidden={i !== 0 ? 'true' : undefined}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${slides.length}: ${slide.caption}`}
      >
        <Photo
          src={slide.image}
          alt={slide.alt}
          eager={hero && i === 0}
          sizes={hero ? '100vw' : '(max-width: 760px) 100vw, 55vw'}
        />
        <figcaption>{slide.caption}</figcaption>
      </figure>
    ))}
  </div>
  <div class="slider-interface">
    <div class="slider-dots" role="group" aria-label="Choose a photograph">
      {slides.map((slide, i) => (
        <button
          type="button"
          class:list={['slider-dot', { 'is-active': i === 0 }]}
          data-to={i}
          aria-label={`Show ${slide.caption}`}
          aria-current={i === 0 ? 'true' : undefined}
          aria-controls={`${id}-frames`}
        >
          <span></span>
        </button>
      ))}
    </div>
    <div class="slider-buttons">
      <button
        type="button"
        class="round-control previous"
        data-previous
        aria-label="Previous photograph"
        aria-controls={`${id}-frames`}
      >
        <Icon name="chevron" size={20} />
      </button>
      <button
        type="button"
        class="round-control"
        data-next
        aria-label="Next photograph"
        aria-controls={`${id}-frames`}
      >
        <Icon name="chevron" size={20} />
      </button>
      {autoplay && (
        <button
          type="button"
          class="round-control"
          data-play
          aria-label="Pause slideshow"
        >
          <span data-pause-icon>
            <Icon name="pause" size={18} />
          </span>
          <span data-play-icon hidden>
            <Icon name="play" size={18} />
          </span>
        </button>
      )}
    </div>
    <span class="sr-only" aria-live="polite" data-status></span>
  </div>
</image-slider>
<script>
  class ImageSlider extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const slides = [...this.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...this.querySelectorAll<HTMLButtonElement>('[data-to]')];
      const playButton = this.querySelector<HTMLButtonElement>('[data-play]');
      const status = this.querySelector<HTMLElement>('[data-status]');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let current = 0,
        timer: ReturnType<typeof setTimeout> | undefined;
      let playing = this.dataset.autoplay === 'true' && !reduced.matches;
      let hovered = false,
        visible = true;
      const stop = () => {
        clearTimeout(timer);
      };
      const updateButton = () => {
        playButton?.setAttribute(
          'aria-label',
          playing ? 'Pause slideshow' : 'Play slideshow',
        );
        const pause = this.querySelector<HTMLElement>('[data-pause-icon]');
        const play = this.querySelector<HTMLElement>('[data-play-icon]');
        if (pause && play) {
          pause.hidden = !playing;
          play.hidden = playing;
        }
      };
      const schedule = () => {
        stop();
        if (playing && !hovered && visible && !document.hidden)
          timer = setTimeout(() => show(current + 1), 6500);
      };
      const show = (index: number, manual = false) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === current);
          slide.setAttribute('aria-hidden', String(i !== current));
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === current);
          if (i === current) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        if (manual) {
          playing = false;
          updateButton();
          if (status)
            status.textContent = slides[current].getAttribute('aria-label');
        }
        schedule();
      };
      this.querySelector('[data-next]')?.addEventListener('click', () =>
        show(current + 1, true),
      );
      this.querySelector('[data-previous]')?.addEventListener('click', () =>
        show(current - 1, true),
      );
      dots.forEach((dot, i) =>
        dot.addEventListener('click', () => show(i, true)),
      );
      playButton?.addEventListener('click', () => {
        playing = !playing;
        updateButton();
        schedule();
      });
      this.addEventListener('mouseenter', () => {
        hovered = true;
        stop();
      });
      this.addEventListener('mouseleave', () => {
        hovered = false;
        schedule();
      });
      this.addEventListener('focusin', (event) => {
        if (event.target !== playButton) {
          playing = false;
          updateButton();
          stop();
        }
      });
      this.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
          event.preventDefault();
          show(current + (event.key === 'ArrowRight' ? 1 : -1), true);
        }
      });
      let touchX = 0;
      this.addEventListener(
        'touchstart',
        (event) => {
          touchX = event.changedTouches[0].clientX;
        },
        { passive: true },
      );
      this.addEventListener(
        'touchend',
        (event) => {
          const delta = event.changedTouches[0].clientX - touchX;
          if (Math.abs(delta) > 50) show(current + (delta < 0 ? 1 : -1), true);
        },
        { passive: true },
      );
      const controller = new AbortController();
      document.addEventListener('visibilitychange', schedule, {
        signal: controller.signal,
      });
      reduced.addEventListener(
        'change',
        () => {
          if (reduced.matches) {
            playing = false;
            updateButton();
            stop();
          }
        },
        { signal: controller.signal },
      );
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        schedule();
      });
      observer.observe(this);
      this.cleanup = () => {
        stop();
        observer.disconnect();
        controller.abort();
      };
      updateButton();
      schedule();
    }
    cleanup?: () => void;
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('image-slider'))
    customElements.define('image-slider', ImageSlider);
</script>
