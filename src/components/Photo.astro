---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  class?: string;
  sizes?: string;
}
const {
  src,
  alt,
  eager = false,
  class: className = '',
  sizes = '(max-width: 760px) 100vw, 50vw',
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  class={className}
  width={Math.min(src.width, 1600)}
  widths={[400, 720, 1100, 1600].filter((w) => w <= src.width)}
  sizes={sizes}
  format="webp"
  quality={82}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
/>
