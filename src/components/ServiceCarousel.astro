---
import { categories } from '../data/services';
import { images } from '../data/images';
import Photo from './Photo.astro';
import Icon, { type IconName } from './Icon.astro';
const icons: Record<(typeof categories)[number]['slug'], IconName> = {
  pregnancy: 'pregnancy',
  general: 'general',
  musculoskeletal: 'muscle',
  vascular: 'pulse',
};
const details: Record<(typeof categories)[number]['slug'], string> = {
  pregnancy: 'Dating, NT, growth and wellbeing scans',
  general: 'Abdominal, pelvic, thyroid, breast and focused scans',
  musculoskeletal: 'Joints, tendons and soft tissues',
  vascular: 'DVT and carotid examinations',
};
---

<service-carousel
  class="service-carousel"
  role="region"
  aria-label="Explore ultrasound services"
>
  <div class="container section-heading">
    <div>
      <p class="section-label">Our expertise</p>
      <h2>
        Ultrasound services,
        <br />
        close to home.
      </h2>
    </div>
    <div class="carousel-heading-aside">
      <p>
        Find your scan. Know what to expect.
        <br />
        Feel ready for your appointment.
      </p>
      <a href="/services/" class="text-link">
        All services <Icon name="arrow" size={20} />
      </a>
    </div>
  </div>
  <div
    class="service-viewport"
    id="service-track"
    aria-label="Ultrasound services"
  >
    <div class="service-track">
      {categories.map((category) => (
        <a href={`/services/${category.slug}/`} class="service-card">
          <div class="service-card-photo">
            <Photo
              src={images[category.image]}
              alt={`Illustrative ${category.short.toLowerCase()} ultrasound examination`}
              sizes="(max-width: 620px) 82vw, 400px"
            />
          </div>
          <div class="service-card-info">
            <Icon name={icons[category.slug]} size={36} />
            <h3>{category.name}</h3>
            <p>{details[category.slug]}</p>
            <span class="service-card-link">
              Explore scans <Icon name="arrow" size={20} />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</service-carousel>
<script>
  class ServiceCarousel extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      if (reduced.matches) return;
      const viewport = this.querySelector<HTMLElement>('.service-viewport')!;
      const track = this.querySelector<HTMLElement>('.service-track')!;
      const cards = [...track.querySelectorAll<HTMLElement>('.service-card')];
      const clones = cards.map((card) => {
        const clone = card.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.setAttribute('tabindex', '-1');
        clone.dataset.clone = 'true';
        track.append(clone);
        return clone;
      });
      this.dataset.ready = 'true';
      let frame: number | undefined;
      let timer: number | undefined;
      let loopWidth = 0;
      let stepWidth = 0;
      let position = 0;
      let visible = true;
      let paused = false;
      const clearTimer = () => {
        if (timer) window.clearTimeout(timer);
        timer = undefined;
      };
      const settle = () => {
        if (frame) cancelAnimationFrame(frame);
        frame = undefined;
        if (!stepWidth) return;
        position = Math.round(viewport.scrollLeft / stepWidth) % cards.length;
        viewport.scrollLeft = position * stepWidth;
      };
      const measure = () => {
        loopWidth = clones[0].offsetLeft - cards[0].offsetLeft;
        stepWidth = cards[1].offsetLeft - cards[0].offsetLeft;
        settle();
      };
      const schedule = () => {
        clearTimer();
        if (
          !visible ||
          paused ||
          document.hidden ||
          reduced.matches ||
          !stepWidth ||
          frame
        )
          return;
        timer = window.setTimeout(advance, 3600);
      };
      const advance = () => {
        timer = undefined;
        if (!visible || paused || document.hidden || reduced.matches) return;
        const from = viewport.scrollLeft;
        const to = from + stepWidth;
        let started = 0;
        const animate = (time: number) => {
          if (!started) started = time;
          const progress = Math.min((time - started) / 1400, 1);
          const eased = progress * progress * (3 - 2 * progress);
          viewport.scrollLeft = from + (to - from) * eased;
          if (progress < 1) {
            frame = requestAnimationFrame(animate);
            return;
          }
          frame = undefined;
          position += 1;
          if (position === cards.length) {
            viewport.scrollLeft = to - loopWidth;
            position = 0;
          }
          schedule();
        };
        frame = requestAnimationFrame(animate);
      };
      const update = () => {
        if (!visible || document.hidden || reduced.matches) {
          clearTimer();
          settle();
          return;
        }
        schedule();
      };
      const controller = new AbortController();
      this.addEventListener(
        'focusin',
        () => {
          paused = true;
          clearTimer();
        },
        { signal: controller.signal },
      );
      this.addEventListener(
        'focusout',
        () => {
          requestAnimationFrame(() => {
            if (!this.contains(document.activeElement)) {
              paused = false;
              schedule();
            }
          });
        },
        { signal: controller.signal },
      );
      const cardFromEvent = (target: EventTarget | null) =>
        target instanceof Element
          ? target.closest<HTMLElement>('.service-card')
          : null;
      track.addEventListener(
        'pointerover',
        (event) => {
          const card = cardFromEvent(event.target);
          const previousCard = cardFromEvent(event.relatedTarget);
          if (card && card !== previousCard) {
            paused = true;
            clearTimer();
          }
        },
        { signal: controller.signal },
      );
      track.addEventListener(
        'pointerout',
        (event) => {
          const card = cardFromEvent(event.target);
          const nextCard = cardFromEvent(event.relatedTarget);
          if (card && card !== nextCard) {
            paused = false;
            schedule();
          }
        },
        { signal: controller.signal },
      );
      document.addEventListener('visibilitychange', update, {
        signal: controller.signal,
      });
      reduced.addEventListener('change', update, { signal: controller.signal });
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        update();
      });
      observer.observe(this);
      const resize = new ResizeObserver(() => {
        measure();
        schedule();
      });
      resize.observe(track);
      this.cleanup = () => {
        clearTimer();
        settle();
        observer.disconnect();
        resize.disconnect();
        controller.abort();
      };
      requestAnimationFrame(() => {
        measure();
        schedule();
      });
    }
    cleanup?: () => void;
    disconnectedCallback() {
      this.cleanup?.();
      delete this.dataset.ready;
    }
  }
  if (!customElements.get('service-carousel'))
    customElements.define('service-carousel', ServiceCarousel);
</script>
