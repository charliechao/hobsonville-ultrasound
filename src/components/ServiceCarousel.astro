---
import { categories } from '../data/services';
import { images } from '../data/images';
import Photo from './Photo.astro';
import Icon, { type IconName } from './Icon.astro';
const icons: IconName[] = ['pregnancy', 'general', 'muscle', 'focus', 'pulse'];
const details = [
  'Dating, NT and growth scans',
  'Abdominal, pelvic and renal scans',
  'Joints, tendons and soft tissues',
  'Thyroid, breast and focused scans',
  'DVT and carotid examinations',
];
---

<service-carousel
  class="service-carousel"
  role="region"
  aria-label="Explore ultrasound services"
>
  <div class="container section-heading">
    <div>
      <p class="section-label">Our expertise</p>
      <h2>
        Care for every
        <br />
        stage of life.
      </h2>
    </div>
    <div class="carousel-heading-aside">
      <p>
        Find your scan. Know what to expect.
        <br />
        Feel ready for your appointment.
      </p>
      <a href="/services/" class="text-link">
        All services <Icon name="arrow" size={20} />
      </a>
    </div>
  </div>
  <div
    class="service-track"
    id="service-track"
    aria-label="Ultrasound services"
  >
    {categories.map((category, i) => (
      <a href={`/services/${category.slug}/`} class="service-card">
        <div class="service-card-photo">
          <Photo
            src={images[category.image]}
            alt={`Illustrative ${category.short.toLowerCase()} ultrasound examination`}
            sizes="(max-width: 620px) 82vw, 400px"
          />
        </div>
        <div class="service-card-info">
          <Icon name={icons[i]} size={36} />
          <h3>{category.name}</h3>
          <p>{details[i]}</p>
          <span class="service-card-link">
            Explore scans <Icon name="arrow" size={20} />
          </span>
        </div>
      </a>
    ))}
  </div>
</service-carousel>
<script>
  class ServiceCarousel extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const track = this.querySelector<HTMLElement>('.service-track')!;
      const cards = [...track.querySelectorAll<HTMLElement>('.service-card')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let current = 0;
      let timer: ReturnType<typeof setTimeout> | undefined;
      let visible = true;
      let paused = false;
      const stop = () => clearTimeout(timer);
      const move = () => {
        current = current === cards.length - 1 ? 0 : current + 1;
        cards[current].scrollIntoView({
          behavior: reduced.matches ? 'instant' : 'smooth',
          block: 'nearest',
          inline: 'start',
        });
      };
      const schedule = () => {
        stop();
        if (!reduced.matches && visible && !paused && !document.hidden)
          timer = setTimeout(() => {
            move();
            schedule();
          }, 6000);
      };
      this.addEventListener('focusin', () => {
        paused = true;
        stop();
      });
      this.addEventListener('focusout', () => {
        requestAnimationFrame(() => {
          if (!this.contains(document.activeElement)) {
            paused = false;
            schedule();
          }
        });
      });
      const controller = new AbortController();
      document.addEventListener('visibilitychange', schedule, {
        signal: controller.signal,
      });
      reduced.addEventListener('change', schedule, {
        signal: controller.signal,
      });
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        schedule();
      });
      observer.observe(this);
      this.cleanup = () => {
        stop();
        observer.disconnect();
        controller.abort();
      };
      schedule();
    }
    cleanup?: () => void;
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('service-carousel'))
    customElements.define('service-carousel', ServiceCarousel);
</script>
