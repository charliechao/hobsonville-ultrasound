---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="Find your way back to Hobsonville Ultrasound services and appointment information."
  noindex
>
  <section class="section">
    <div class="container reading">
      <p class="eyebrow">404 · Page not found</p>
      <h1>
        Let’s get you
        <br />
        back on track.
      </h1>
      <p>
        The page may have moved. Explore our examinations or contact reception
        for help.
      </p>
      <div class="actions">
        <a class="button" href="/services/">
          Find your scan ↗
        </a>
        <a href="/">Back to home</a>
      </div>
    </div>
  </section>
</Layout>
