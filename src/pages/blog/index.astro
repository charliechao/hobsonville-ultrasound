---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Callout from '../../components/Callout.astro';
import MonthlyHighlights from '../../components/MonthlyHighlights.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import { images } from '../../data/images';
import {
  highlightsFor,
  monthLabel,
  previewHighlights,
  publishedMonthlyEntries,
} from '../../data/monthly';

const entries = await publishedMonthlyEntries();
const [latest, ...earlier] = entries;
---

<Layout
  title="This Month at Hobsonville Ultrasound"
  description="Monthly clinic updates, useful ultrasound facts and practical scan guidance from Hobsonville Ultrasound."
  noindex={!latest}
>
  <section class="blog-hero" aria-labelledby="blog-title">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Insights' }]} />
      <div class="blog-hero-grid">
        <div class="blog-hero-copy">
          <p class="section-label">Insights from our clinic</p>
          <h1 id="blog-title">This Month at Hobsonville Ultrasound</h1>
          <p class="lead">A little something useful each month.</p>
          <p>
            Clinic news, ultrasound facts and clear answers to common questions
            about scans and appointments.
          </p>
        </div>
        <figure class="blog-hero-photo">
          <Photo
            src={images.machine}
            alt="Ultrasound machine in a softly lit room"
            sizes="(max-width: 850px) 100vw, 45vw"
            eager
          />
          <figcaption>Ultrasound equipment</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section blog-latest" aria-labelledby="blog-latest-title">
    <div class="container">
      <div class="blog-section-heading">
        <div>
          <p class="section-label">
            {latest ? monthLabel(latest.id) : 'Coming soon'}
          </p>
          <h2 id="blog-latest-title">
            {latest
              ? 'The latest from our clinic.'
              : 'Our first monthly update is on its way.'}
          </h2>
          {!latest && (
            <p>
              Here is a preview of the three things you will find in each
              monthly edition.
            </p>
          )}
        </div>
        {latest && (
          <a class="text-link" href={`/blog/${latest.id}/`}>
            Open {monthLabel(latest.id)} <Icon name="arrow" size={20} />
          </a>
        )}
      </div>
      <MonthlyHighlights
        highlights={latest ? highlightsFor(latest) : previewHighlights}
      />
      {!latest && (
        <div class="blog-placeholder-note">
          <p>
            While we prepare the first edition, you can find the information you
            need for your visit in our service and preparation guides.
          </p>
          <div class="actions">
            <a class="text-link" href="/services/">
              Browse our services
            </a>
            <a class="text-link" href="/patient-information/">
              Prepare for your scan
            </a>
          </div>
        </div>
      )}
    </div>
  </section>

  {earlier.length > 0 && (
    <section class="section blog-archive" aria-labelledby="blog-archive-title">
      <div class="container">
        <p class="section-label">Monthly archive</p>
        <h2 id="blog-archive-title">Earlier updates</h2>
        <ol>
          {earlier.map((entry) => (
            <li>
              <a href={`/blog/${entry.id}/`}>
                <span>{monthLabel(entry.id)}</span>
                <strong>{entry.data.update.title}</strong>
                <Icon name="arrow" size={21} />
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
  <Callout />
</Layout>
