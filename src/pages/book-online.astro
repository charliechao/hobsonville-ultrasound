---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Callout from '../components/Callout.astro';
import ServiceCategoryNav from '../components/ServiceCategoryNav.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/services';
---

<Layout title="Book an ultrasound" description="Choose your ultrasound category, check scan preparation and pricing, and book online or contact reception.">
  <PageIntro title="Let’s find your appointment." eyebrow="Book an ultrasound" description="Choose a category, then open the examination on your referral to see preparation, pricing and booking options." compact />
  <ServiceCategoryNav context="booking" />
  <section class="section booking-page">
    <div class="container two-column">
      <div>
        {categories.map((category) => (
          <section id={category.slug} class="booking-group">
            <h2>{category.name}</h2>
            <p>{category.intro}</p>
            <a class="text-link" href={`/services/${category.slug}/`}>
              Choose a {category.short.toLowerCase()} scan <Icon name="arrow" size={20} />
            </a>
          </section>
        ))}
      </div>
      <aside>
        <div class="sidebar-panel">
          <h2>Your booking checklist</h2>
          <ul>
            <li>Have your referral ready for diagnostic scans.</li>
            <li>Check the preparation for your examination.</li>
            <li>Review the price and eligibility information.</li>
            <li>Contact reception if you need help choosing your scan.</li>
          </ul>
          <a href="/pricing/">View prices</a>
          <p style="margin-top:1.2rem"><a href="/appointment-policy/">Cancellation and appointment policy</a></p>
        </div>
      </aside>
    </div>
  </section>
  <Callout />
</Layout>
