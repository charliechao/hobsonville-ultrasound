---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Layout
  title="Contact and directions"
  description="Contact Hobsonville Ultrasound, formerly Body 2 Baby Ultrasound, on 09 869 3328. Find us on Level 1, 124 Hobsonville Road, above Unichem Pharmacy, with free visitor parking."
>
  <PageIntro
    title="We’re here to help."
    eyebrow="Contact & find us"
    description="Questions about your referral, preparation or appointment? Get in touch with our reception team."
  />
  <section class="section">
    <div class="container split split-top">
      <div>
        <p class="eyebrow">Talk to reception</p>
        <a class="contact-link" href={site.tel} data-event="phone_click">
          {site.phone}
        </a>
        <a href={`mailto:${site.email}`} data-event="email_click">
          {site.email}
        </a>
        <div class="clinic-hours" aria-labelledby="clinic-hours-heading">
          <div class="clinic-hours-heading">
            <Icon name="clock" size={25} />
            <div>
              <p class="eyebrow">Clinic hours</p>
              <h2 id="clinic-hours-heading">When we’re open.</h2>
            </div>
          </div>
          <dl>
            {site.openingHours.map(({ days, hours }) => (
              <div>
                <dt>{days}</dt>
                <dd>{hours}</dd>
              </div>
            ))}
          </dl>
          <p>
            Please contact reception for appointment availability and scan
            times.
          </p>
        </div>
        <a class="button" href="/book-online/">
          Book an ultrasound ↗
        </a>
        <div class="notice">
          <p>
            To cancel or reschedule, call, leave a voicemail, or reply to your
            confirmation text at least 24 hours before your appointment.
          </p>
        </div>
      </div>
      <div>
        <p class="eyebrow">Visit the clinic</p>
        <h2>
          Hobson Centre,
          <br />
          Level 1.
        </h2>
        <p>
          124 Hobsonville Road
          <br />
          Hobsonville, Auckland
        </p>
        <ul class="location-details">
          <li>
            <strong>Above Unichem Pharmacy</strong>Find us at the Woolworths
            shopping centre.
          </li>
          <li>
            <strong>Free visitor parking</strong>Contact reception if you need
            help planning your arrival.
          </li>
        </ul>
        <a
          class="text-link"
          href={site.directions}
          target="_blank"
          rel="noopener noreferrer"
          data-event="directions_click"
        >
          Open directions in Google Maps ↗
        </a>
      </div>
    </div>
  </section>
  <section class="section-tight mist">
    <div class="container">
      <h2>Find your way here.</h2>
      <iframe
        class="map"
        title="Map showing Hobsonville Ultrasound at 124 Hobsonville Road"
        src={site.mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <p class="small" style="margin-top:1rem">
        Map provided by Google.{' '}
        <a
          href={site.directions}
          target="_blank"
          rel="noopener noreferrer"
          data-event="directions_click"
        >
          Open a larger map and directions ↗
        </a>
      </p>
    </div>
  </section>
</Layout>
