---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import FAQ from '../components/FAQ.astro';
import Callout from '../components/Callout.astro';
import Icon from '../components/Icon.astro';
import ImageSlider from '../components/ImageSlider.astro';
import ServiceCarousel from '../components/ServiceCarousel.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { images } from '../data/images';
import { services, serviceUrl } from '../data/services';
import { site } from '../data/site';
const featured = ['dating', 'pelvic', 'abdominal'].map((slug) =>
  services.find((s) => s.slug === slug)!,
);
const heroSlides = [
  {
    image: images.room,
    alt: 'The examination room at Hobsonville Ultrasound',
    caption: 'Our clinic · Hobsonville',
  },
  {
    image: images.reception,
    alt: 'Reception and the current Hobsonville Ultrasound signage',
    caption: 'A warm welcome · Our reception',
  },
  {
    image: images.probe,
    alt: 'An ultrasound probe, shown as an illustrative equipment detail',
    caption: 'Detailed imaging · Equipment illustration',
  },
];
---

<Layout
  title="Hobsonville Ultrasound | Formerly Body 2 Baby Ultrasound"
  fullTitle
  description="Hobsonville Ultrasound, formerly Body 2 Baby Ultrasound. Experienced diagnostic ultrasound in Hobsonville, West Auckland: pregnancy, general, MSK, small parts and vascular scans."
>
  <section class="premium-hero">
    <ImageSlider
      id="home-hero"
      label="Hobsonville Ultrasound clinic and imaging photographs"
      slides={heroSlides}
      hero
      autoplay
      controls={false}
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container premium-hero-content">
      <p class="hero-location">
        <Icon name="pin" size={18} /> Hobsonville, Auckland
      </p>
      <h1>
        Experienced ultrasound care,
        <span>right here in Hobsonville.</span>
      </h1>
      <p>
        Professional diagnostic ultrasound with over 12 years of sonography
        experience, for Hobsonville and the wider West Auckland community.
      </p>
      <div class="actions">
        <a class="button button-accent" href="/book-online/">
          <Icon name="calendar" size={21} /> Book an ultrasound
        </a>
        <a class="hero-secondary" href="/services/">
          View our services <Icon name="arrow" size={20} />
        </a>
      </div>
      <div class="hero-assurance">
        <Icon name="shield" size={24} />
        <span>
          Experienced hands. Detailed imaging. Personal care.
          <br />
          <small>Formerly Body 2 Baby Ultrasound</small>
        </span>
      </div>
    </div>
    <a
      class="hero-scroll"
      href="#your-care"
      aria-label="Explore your care options"
    >
      <span>Explore your care</span>
      <Icon name="arrow" size={20} />
    </a>
  </section>
  <section
    class="quick-paths container"
    id="your-care"
    aria-label="Plan your appointment"
  >
    <a href="/patient-information/">
      <Icon name="file" size={31} />
      <span>
        <strong>Prepare for your scan</strong>
        <small>A little guidance before your visit</small>
      </span>
      <Icon name="chevron" size={18} />
    </a>
    <a href="/pricing/">
      <Icon name="wallet" size={31} />
      <span>
        <strong>Clear, upfront pricing</strong>
        <small>Know your cost before you book</small>
      </span>
      <Icon name="chevron" size={18} />
    </a>
    <a href="/contact/">
      <Icon name="pin" size={31} />
      <span>
        <strong>Find us in Hobsonville</strong>
        <small>Level 1 · Free visitor parking</small>
      </span>
      <Icon name="chevron" size={18} />
    </a>
  </section>
  <section class="services-section section">
    <ServiceCarousel />
  </section>
  <section class="practice-section section">
    <div class="container practice-grid">
      <div class="practice-images" data-reveal>
        <ImageSlider
          id="clinic-gallery"
          label="Take a look inside our clinic"
          slides={heroSlides.slice(0, 2).reverse()}
        />
        <div class="practice-image-note">
          <Icon name="care" size={30} />
          <span>
            Local people.
            <br />
            <strong>Personal attention.</strong>
          </span>
        </div>
      </div>
      <div class="practice-copy" data-reveal>
        <p class="section-label">Welcome to your local practice</p>
        <h2>
          More than just an ultrasound.
          <br />
          <span>Care centred on you.</span>
        </h2>
        <p class="lead">
          Experienced sonography, attention to detail, and making every patient
          feel comfortable and cared for.
        </p>
        <p>
          We bring more than 12 years of sonography experience across public and
          private healthcare in New Zealand and South Africa to our Hobsonville
          clinic.
        </p>
        <p>
          From the moment you arrive, we aim to make your appointment
          professional, welcoming and straightforward, while taking the time to
          provide detailed imaging and care tailored to your needs.
        </p>
        <div class="practice-values">
          <span>
            <Icon name="scan" /> Detailed imaging
          </span>
          <span>
            <Icon name="care" /> Personal care
          </span>
          <span>
            <Icon name="pin" /> Close to home
          </span>
        </div>
        <a class="button button-outline" href="/about/">
          Get to know us <Icon name="arrow" size={20} />
        </a>
      </div>
    </div>
  </section>
  <div class="name-change">
    <div class="container">
      <Icon name="care" size={25} />
      <p>
        <strong>A familiar clinic. A new name.</strong> Formerly Body 2 Baby
        Ultrasound, now Hobsonville Ultrasound. Same team and care.
      </p>
      <a href="/about/" aria-label="Read about our name change">
        <Icon name="arrow" />
      </a>
    </div>
  </div>
  <GoogleReviews />
  <section class="section home-pricing">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <p class="section-label">Clarity before your appointment</p>
          <h2>
            Clear, upfront pricing.
            <br />
            Know what it costs.
          </h2>
        </div>
        <a class="text-link" href="/pricing/">
          View all prices <Icon name="arrow" size={20} />
        </a>
      </div>
      <div class="pricing-composition">
        <div class="pricing-photo" data-reveal>
          <Photo
            src={images.pregnancy}
            alt="Illustrative close-up of an ultrasound examination during pregnancy"
            sizes="(max-width: 760px) 100vw, 40vw"
          />
          <div>
            <Icon name="care" size={27} />
            <span>
              Here for your
              <br />
              <strong>important moments.</strong>
            </span>
          </div>
        </div>
        <div class="price-editorial" data-reveal>
          {featured.map((service) => (
            <a class="price-editorial-row" href={serviceUrl(service)}>
              <div>
                <h3>{service.name}</h3>
                <p>
                  {service.pregnancyEligible
                    ? 'Eligible NZ maternity patients'
                    : 'Diagnostic scan · referral required'}
                </p>
              </div>
              <span class="price-value">${service.price}</span>
              <Icon name="arrow" size={21} />
            </a>
          ))}
          <p class="small muted">
            Community Services Card pricing is available for eligible pregnancy
            scans. Confirm eligibility and your final cost with reception.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="visit-section section">
    <div class="container split split-top">
      <div data-reveal>
        <p class="section-label">Your appointment, made easier</p>
        <h2>
          A little preparation.
          <br />A more relaxed visit.
        </h2>
        <div class="visit-steps">
          <a href="/patient-information/">
            <Icon name="file" size={28} />
            <div>
              <h3>Have your referral ready</h3>
              <p>
                Bring it along if your health professional has not already sent
                it.
              </p>
            </div>
          </a>
          <a href="/patient-information/">
            <Icon name="clock" size={28} />
            <div>
              <h3>Check your preparation</h3>
              <p>
                Your scan may require fasting or a full bladder. Read your
                appointment instructions.
              </p>
            </div>
          </a>
          <a href="/contact/">
            <Icon name="parking" size={28} />
            <div>
              <h3>Arrive with one less worry</h3>
              <p>
                Find us above Unichem Pharmacy at Woolworths, with free visitor
                parking.
              </p>
            </div>
          </a>
        </div>
      </div>
      <div class="home-faq" data-reveal>
        <p class="section-label">Good to know</p>
        <FAQ />
        <a class="text-link" href="/faq/">
          More questions, answered <Icon name="arrow" size={20} />
        </a>
      </div>
    </div>
  </section>
  <section class="section home-location">
    <div class="container location-composition">
      <div data-reveal>
        <p class="section-label">Your local ultrasound practice</p>
        <h2>
          Your neighbourhood.
          <br />
          <span>Your ultrasound clinic.</span>
        </h2>
        <p>
          Conveniently located in Hobsonville, we provide diagnostic ultrasound
          for patients throughout Hobsonville and the wider West Auckland
          community, including West Harbour, Westgate, Massey, Whenuapai, Te
          Atatū and Greenhithe.
        </p>
        <p>
          Being local means professional ultrasound care close to home, without
          travelling across Auckland. Looking for an ultrasound clinic in
          Hobsonville or West Auckland? We’re here to help.
        </p>
        <div class="location-address">
          <Icon name="pin" size={29} />
          <p>
            <strong>Hobson Centre, Level 1</strong>
            <br />
            124 Hobsonville Road, Hobsonville
            <br />
            <small>Above Unichem Pharmacy, at Woolworths</small>
          </p>
        </div>
        <div class="actions">
          <a
            class="button"
            href={site.directions}
            target="_blank"
            rel="noopener noreferrer"
            data-event="directions_click"
          >
            <Icon name="pin" size={20} /> Get directions
          </a>
          <a class="text-link" href={site.tel} data-event="phone_click">
            <Icon name="phone" size={19} /> {site.phone}
          </a>
        </div>
      </div>
      <div class="location-map" data-reveal>
        <iframe
          class="map"
          title="Hobsonville Ultrasound at 124 Hobsonville Road"
          src={site.mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <div>
          <Icon name="parking" size={22} /> Free visitor parking{' '}
          <span>Hobsonville, Auckland</span>
        </div>
      </div>
    </div>
  </section>
  <Callout />
</Layout>
