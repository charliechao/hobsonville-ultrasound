---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Callout from '../components/Callout.astro';
import { preparation, type Prep } from '../data/services';
import { site } from '../data/site';

const prepGroups: { title: string; prep: Prep; extra?: string[] }[] = [
  { title: 'Upper abdomen', prep: 'abdomen' },
  { title: 'Pelvis, renal and kidney', prep: 'pelvis' },
  { title: 'Abdomen and pelvis', prep: 'combined' },
  {
    title: 'Pregnancy (obstetric)',
    prep: 'dating',
    extra: ['For other pregnancy scans, no special preparation is required.'],
  },
  {
    title: 'Musculoskeletal and nerves',
    prep: 'msk',
    extra: [
      'The same applies to other joints: wear clothing that lets you uncover the area easily.',
    ],
  },
  { title: 'Vascular', prep: 'none' },
];
---

<Layout
  title="Patient information and scan preparation"
  description="Prepare for your ultrasound appointment in Hobsonville. Learn how to prepare, what to bring, support-person guidance, results and payment information."
>
  <PageIntro
    title="Feel prepared for your visit."
    eyebrow="Patient information"
    description="A few practical details to help you arrive feeling comfortable and ready for your ultrasound."
  >
    <div class="jump-links">
      <a href="#prepare">How to prepare</a>
      <a href="#bring">What to bring</a>
      <a href="#clinic">At the clinic</a>
      <a href="#after">After your scan</a>
      <a href="#payment">Payment</a>
    </div>
  </PageIntro>
  <section class="section">
    <div class="container two-column">
      <div class="prose">
        <h2 id="prepare">How to prepare</h2>
        <p>
          Preparation varies by examination. Open the section for your scan
          below, and follow any individual instructions sent with your
          appointment.
        </p>
        <div class="faq-list accordion">
          {prepGroups.map((group) => (
            <details>
              <summary>
                {group.title}
                <span aria-hidden="true">+</span>
              </summary>
              <ul>
                {[...preparation[group.prep], ...(group.extra ?? [])].map(
                  (line) => (
                    <li>{line}</li>
                  ),
                )}
              </ul>
            </details>
          ))}
        </div>
        <div class="notice">
          <p>
            If you have diabetes, difficulty with preparation, or questions
            about your instructions, contact your doctor or our reception team
            before your visit.
          </p>
        </div>
        <h2 id="bring">What to bring</h2>
        <ul>
          <li>
            Your completed referral form, if it has not already been emailed to
            us.
          </li>
          <li>
            Previous images and reports, if available (for example X-ray,
            ultrasound, CT or MRI).
          </li>
          <li>
            Your Community Services Card, if it applies to your appointment.
          </li>
        </ul>
        <h2 id="clinic">At the clinic</h2>
        <p>
          Find us on Level 1 of the Hobson Centre, above Unichem Pharmacy at
          Woolworths, 124 Hobsonville Road. Free visitor parking is available.
          Please arrive on time; most examinations take around 30 minutes.
        </p>
        <p>
          You may bring one adult support person. For everyone’s comfort and
          privacy, please avoid bringing children where possible. If this is
          unavoidable, one child may attend and must be supervised by another
          responsible adult.
        </p>
        <h2 id="after">After your scan</h2>
        <p>
          Your images are reviewed by our reporting radiologist, and the report
          is sent to your referring doctor or health professional once complete.
          Your referrer will explain the findings and discuss next steps.
        </p>
        <p>
          A copy of your images can be provided by secure email link for $10 per
          study, where not already included. To request a copy of your report,
          email{' '}
          <a href={`mailto:${site.email}`} data-event="email_click">
            {site.email}
          </a>
          .
        </p>
        <h2 id="payment">Payment and appointment changes</h2>
        <p>
          Payment is due at your appointment. Please give at least 24 hours’
          notice if you need to cancel or reschedule. Late cancellation or
          non-attendance may incur a $50 fee.
        </p>
        <a href="/appointment-policy/">Read the full appointment policy</a>
      </div>
      <aside>
        <div class="sidebar-panel">
          <h2>Find your scan</h2>
          <p>
            Your examination page brings together preparation, pricing and
            booking information.
          </p>
          <a class="button" href="/services/">
            Explore examinations ↗
          </a>
          <p style="margin-top:1.5rem">
            <a href="/pricing/">Pricing and eligibility</a>
          </p>
          <p>
            <a href="/faq/">Frequently asked questions</a>
          </p>
          <a href="/contact/">Location and contact details</a>
        </div>
      </aside>
    </div>
  </section>
  <Callout />
</Layout>
