---
import BookingButton from '../components/BookingButton.astro';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Callout from '../components/Callout.astro';
import { pricingGroups, nonEligibleMaternityPrice } from '../data/services';
import { site } from '../data/site';
---

<Layout
  title="Ultrasound pricing"
  description="View Hobsonville Ultrasound prices for pregnancy, general, musculoskeletal and vascular examinations, plus payment and eligibility information."
>
  <PageIntro title="Ultrasound pricing" compact />
  <section class="section pricing-page">
    <div class="container two-column">
      <div>
        {pricingGroups.map((group) => (
          <table class="price-table">
            <caption>{group.name}</caption>
            <thead>
              <tr>
                <th scope="col">Examination</th>
                <th scope="col">Price (NZD)</th>
              </tr>
            </thead>
            <tbody>
              {group.rows.map(([name, price]) => (
                <tr>
                  <th scope="row">{name}</th>
                  <td>{price}</td>
                </tr>
              ))}
            </tbody>
            {group.slug === 'musculoskeletal' && (
              <tfoot>
                <tr>
                  <td colspan="2" class="pricing-acc-note">
                    <strong>ACC referrals:</strong> There is currently no
                    patient charge for musculoskeletal examinations with an ACC
                    referral.
                  </td>
                </tr>
              </tfoot>
            )}
          </table>
        ))}
      </div>
      <aside class="prose">
        <div class="sidebar-panel">
          <h2>Before you book</h2>
          <p>
            Diagnostic scans require a referral. Send it to{' '}
            <a href={`mailto:${site.email}`} data-event="email_click">
              {site.email}
            </a>{' '}
            or bring it to your appointment.
          </p>
          <p>
            Payment is due at your appointment. Confirm the final cost with
            reception.
          </p>
          <h3>Pregnancy pricing</h3>
          <p>
            Listed prices apply to eligible NZ maternity patients; with a
            Community Services Card, eligible scans are <strong>$30</strong>.
            Diagnostic pregnancy scans cost{' '}
            <strong>${nonEligibleMaternityPrice}</strong> if you are not
            eligible for NZ maternity funding. Ask reception if you are unsure
            which rate applies.
          </p>
          <h3>Digital images</h3>
          <p>
            <strong>$10 per study</strong> for a secure image link, where not
            already included.
          </p>
          <BookingButton />
        </div>
        <h3>Changes or cancellations</h3>
        <p>
          Please give at least 24 hours’ notice. Late cancellations and missed
          appointments may incur a $50 fee.
        </p>
        <a href="/appointment-policy/">Read our appointment policy</a>
      </aside>
    </div>
  </section>
  <Callout />
</Layout>
