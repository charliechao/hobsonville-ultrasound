---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
import { services } from '../data/services';

const referrers = [
  'Medical physicians and specialists',
  'Sport and exercise physicians',
  'GPs',
  'Chiropractors',
  'Physiotherapists',
  'Osteopaths',
  'Podiatrists',
  'Nurse practitioners',
  'LMCs and midwives',
];
const keyPrices = [
  ['abdominal', 'Abdominal'],
  ['pelvic', 'Pelvic'],
  ['renal-tract', 'Renal tract'],
  ['shoulder', 'MSK, one region'],
  ['thyroid', 'Thyroid'],
  ['dvt', 'DVT, one limb'],
  ['carotid', 'Carotid Doppler'],
  ['dating', 'Pregnancy scans, eligible NZ maternity'],
].map(([slug, label]) => {
  const service = services.find((s) => s.slug === slug)!;
  return [
    label,
    `${service.pregnancyEligible ? 'From ' : ''}$${service.price}`,
  ];
});
const { form } = site.referral;
---

<Layout
  title="Information for referrers"
  description="Download Hobsonville Ultrasound’s referral form and find PACS image access, reporting and referral information for clinicians."
>
  <PageIntro
    title="A local partner in patient care."
    eyebrow="For referring clinicians"
    description="Accessible diagnostic ultrasound in Hobsonville, with an experienced team and a personal approach to your patients’ care."
  />
  <section class="section">
    <div class="container two-column">
      <div class="prose">
        <div class="notice notice-strong">
          <p class="eyebrow">Referral form</p>
          <h2>Start with the referral form.</h2>
          <p>
            Download our standard referral form, complete the clinical
            indication and examination required, then send it to us or give it
            to your patient.
          </p>
          <div class="actions">
            <a class="button" href={form} download>
              <Icon name="file" size={20} /> Download referral form (PDF)
            </a>
          </div>
        </div>
        <h2>Who can refer</h2>
        <p>We accept referrals from all NZ-based and registered:</p>
        <ul class="referrer-list">
          {referrers.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <h2>How to refer</h2>
        <ol>
          <li>
            Complete the referral form with the clinical indication and
            examination required.
          </li>
          <li>
            Give it to your patient, or send it directly to{' '}
            <a href={`mailto:${site.email}`} data-event="email_click">
              {site.email}
            </a>
            . Please call before sending sensitive patient information by email.
          </li>
          <li>
            Our team will contact the patient to arrange a suitable appointment
            and confirm any preparation instructions.
          </li>
        </ol>
        <div class="actions">
          <a class="button button-outline" href={form} download>
            <Icon name="file" size={20} /> Download referral form (PDF)
          </a>
          <a class="button button-outline" href="/pricing/">
            View price list
          </a>
          <a class="text-link" href={site.tel} data-event="phone_click">
            Call {site.phone}
          </a>
        </div>
        <h2>Examinations available</h2>
        <p>
          Our services cover pregnancy, general, musculoskeletal, small parts
          and vascular ultrasound. Please contact us to discuss a particular
          examination or confirm availability.
        </p>
        <a href="/services/">Browse our examination directory</a>
        <h2>Reports and access</h2>
        <p>
          Diagnostic images are reviewed by our reporting radiologist, and
          reports are delivered electronically to the referring clinician.
        </p>
        <p>
          Reports are typically available within 24–48 hours of the scan. Urgent
          findings can be communicated by phone.
        </p>
        <h2>PACS / image access</h2>
        <p>
          Referring practitioners can securely access patient images and reports
          through our PACS portal.
        </p>
        <p>
          To request access credentials, or to register for the first time,
          contact our reception team.
        </p>
        <div class="actions">
          <a
            class="button button-outline"
            href={`mailto:${site.email}?subject=PACS%20access%20request`}
            data-event="email_click"
          >
            Request PACS access
          </a>
          <a class="text-link" href={site.tel} data-event="phone_click">
            Call {site.phone}
          </a>
        </div>
      </div>
      <aside>
        <div class="sidebar-panel">
          <p class="eyebrow">Clear, upfront pricing</p>
          <h2>Key prices</h2>
          <table class="price-table key-prices">
            <caption class="sr-only">Selected examination prices</caption>
            <tbody>
              {keyPrices.map(([name, price]) => (
                <tr>
                  <th scope="row">{name}</th>
                  <td>{price}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="small">
            Eligible pregnancy scans are $30 with a Community Services Card.
            ACC-funded examinations may have a patient contribution.
          </p>
          <a class="button" href="/pricing/">
            View full price list
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
