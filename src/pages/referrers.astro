---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
import { categories, services } from '../data/services';

const referrers = [
  'Medical physicians and specialists',
  'Sport and exercise physicians',
  'GPs',
  'Chiropractors',
  'Physiotherapists',
  'Osteopaths',
  'Podiatrists',
  'Nurse practitioners',
  'LMCs and midwives',
];
const keyPrices = [
  ['abdominal', 'Abdominal'],
  ['shoulder', 'MSK, one region'],
  ['thyroid', 'Thyroid'],
  ['dvt', 'DVT, one limb'],
  ['dating', 'Pregnancy scans, eligible NZ maternity'],
].map(([slug, label]) => {
  const service = services.find((s) => s.slug === slug)!;
  return [
    label,
    `${service.pregnancyEligible ? 'From ' : ''}$${service.price}`,
  ];
});
const { form } = site.referral;
---

<Layout
  title="Information for referrers"
  description="Download Hobsonville Ultrasound’s referral form and find PACS image access, reporting and referral information for clinicians."
>
  <PageIntro
    title="Information for referrers"
    eyebrow="For referring clinicians"
    description="Download the referral form and find the steps for referrals, reports and image access."
    compact
  >
    <div class="referrer-form-hero">
      <div>
        <strong>Start with the referral form</strong>
        <span>One form for the examination and clinical indication.</span>
      </div>
      <a class="button booking-button" href={form} download>
        <Icon name="file" size={20} /> Download referral form (PDF)
      </a>
    </div>
  </PageIntro>
  <section class="section referrers-page">
    <div class="container two-column">
      <div class="prose">
        <h2 id="referrals">Referrals</h2>
        <p>
          We accept referrals from these New Zealand registered professionals:
        </p>
        <ul class="referrer-list">
          {referrers.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <h2 id="how-to-refer">How to refer</h2>
        <ol class="referral-steps">
          <li>
            <strong>Complete the form</strong>
            <span>
              Include the clinical indication and examination required.
            </span>
          </li>
          <li>
            <strong>Send the referral</strong>
            <span>
              Give it to your patient or send it to{' '}
              <a href={`mailto:${site.email}`} data-event="email_click">
                {site.email}
              </a>
              .
            </span>
          </li>
          <li>
            <strong>We arrange the appointment</strong>
            <span>Our team contacts the patient and confirms preparation.</span>
          </li>
        </ol>
        <h2 id="reports">Reports</h2>
        <p>
          Diagnostic images are reviewed by our reporting radiologist, and
          reports are delivered electronically to the referring clinician.
        </p>
        <p>
          Reports are typically available within 24–48 hours of the scan. Urgent
          findings can be communicated by phone.
        </p>
        <h2 id="pacs">PACS / image access</h2>
        <p>
          Referring practitioners can securely access patient images and reports
          through our PACS portal. Ask reception for credentials or first-time
          registration.
        </p>
        <div class="actions">
          <a
            class="button booking-button referrer-pacs-action"
            href={`mailto:${site.email}?subject=PACS%20access%20request`}
            data-event="email_click"
          >
            <Icon name="shield" size={20} />
            Request PACS access
          </a>
          <a class="text-link" href={site.tel} data-event="phone_click">
            Call {site.phone}
          </a>
        </div>
      </div>
      <aside>
        <div class="sidebar-panel referrer-sidebar">
          <h2>Services &amp; pricing</h2>
          <p>
            Browse the five diagnostic service areas or check a selected price
            below.
          </p>
          <nav
            class="referrer-service-links"
            aria-label="Ultrasound service categories"
          >
            {categories.map((category) => (
              <a href={`/services/${category.slug}/`}>{category.short}</a>
            ))}
          </nav>
          <table class="price-table key-prices">
            <caption class="sr-only">Selected examination prices</caption>
            <tbody>
              {keyPrices.map(([name, price]) => (
                <tr>
                  <th scope="row">{name}</th>
                  <td>{price}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="small">
            Eligible pregnancy scans are $30 with a Community Services Card.
            There is currently no patient charge for examinations with an ACC
            referral.
          </p>
          <a class="button button-outline" href="/pricing/">
            View all prices <Icon name="arrow" size={20} />
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
