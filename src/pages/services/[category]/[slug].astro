---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Callout from '../../../components/Callout.astro';
import FAQ from '../../../components/FAQ.astro';
import Photo from '../../../components/Photo.astro';
import Icon from '../../../components/Icon.astro';
import { images } from '../../../data/images';
import {
  categories,
  services,
  preparation,
  bookingUrl,
  serviceUrl,
} from '../../../data/services';
import { site } from '../../../data/site';
export function getStaticPaths() {
  return services.map((service) => ({
    params: { category: service.category, slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
const category = categories.find((c) => c.slug === service.category)!;
const related = services
  .filter((s) => s.category === service.category && s.slug !== service.slug)
  .slice(0, 4);
const priceSummary =
  (service.slug === 'other-vascular' ? 'From ' : '') +
  `$${service.price}` +
  (service.priceNote && service.slug !== 'other-vascular'
    ? ` (${service.priceNote})`
    : '') +
  (service.pregnancyEligible
    ? ' for eligible NZ maternity patients, or $30 with a Community Services Card.'
    : '.');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  provider: { '@id': `${site.url}/#clinic` },
  url: site.url + serviceUrl(service),
  areaServed: 'Auckland',
};
---

<Layout
  title={service.name}
  description={`${service.name} at Hobsonville Ultrasound. View preparation instructions, pricing and appointment information.`}
  schema={schema}
>
  <section class="page-intro">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Services', href: '/services/' },
          { label: category.short, href: `/services/${category.slug}/` },
          { label: service.name },
        ]}
      />
      <div class="intro-composition">
        <div>
          <p class="section-label">{category.name}</p>
          <h1>{service.name}</h1>
          <p class="lead">{service.description}</p>
        </div>
        <Photo
          src={images[category.image]}
          alt={`Illustrative ${category.short.toLowerCase()} ultrasound examination`}
          class="intro-photo"
          eager
        />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container two-column">
      <div class="prose">
        <h2>
          <Icon name="scan" size={27} /> About this examination
        </h2>
        <p>{service.assesses}</p>
        <h3>When it may be requested</h3>
        <ul>
          {service.reasons.map((reason) => (
            <li>{reason}</li>
          ))}
        </ul>
        {service.urgentNote && (
          <div class="notice notice-urgent">
            <p>{service.urgentNote}</p>
          </div>
        )}
        <h2>
          <Icon name="care" size={27} /> What to expect
        </h2>
        <ul>
          {category.expect.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
        <p>
          Our team will explain the examination and answer your questions.
          Please let reception know beforehand if you need any support for your
          visit.
        </p>
        <h2>
          <Icon name="clock" size={27} /> Preparing for your scan
        </h2>
        <ul>
          {preparation[service.prep].map((line) => (
            <li>{line}</li>
          ))}
        </ul>
        <p>
          If your appointment instructions differ, or you have questions about
          preparation, contact reception before your visit.
        </p>
        <h3>What to bring</h3>
        <ul>
          <li>
            Your completed referral, if it has not already been sent to the
            clinic.
          </li>
          <li>Relevant previous imaging or reports, where available.</li>
          <li>
            Your Community Services Card if it applies to your appointment.
          </li>
        </ul>
        <h2>
          <Icon name="file" size={27} /> Referral requirements
        </h2>
        {service.nonDiagnostic ? (
          <p>
            This is a non-diagnostic scan. Please contact reception to confirm
            whether a referral is needed before you book.
          </p>
        ) : (
          <p>{category.referral}</p>
        )}
        <p>
          Send a copy or clear photo of your referral to{' '}
          <a href={`mailto:${site.email}`} data-event="email_click">
            {site.email}
          </a>{' '}
          before your appointment, or bring it with you. If you are unsure
          whether your referral is suitable, please contact us.
        </p>
        <h2>
          <Icon name="wallet" size={27} /> Pricing
        </h2>
        <p>
          {priceSummary} Payment is due at your appointment.{' '}
          <a href="/pricing/">View all prices</a>
        </p>
        <h2>
          <Icon name="scan" size={27} /> Your results
        </h2>
        {service.nonDiagnostic ? (
          <p>
            This scan is non-diagnostic and does not replace your diagnostic
            pregnancy examinations. Please ask reception which images are
            included with your appointment.
          </p>
        ) : (
          <p>
            Your images are reviewed by our reporting radiologist and the
            completed report is sent to your referring clinician. Your referrer
            will discuss the results and next steps with you.
          </p>
        )}
        <p>
          <a href="/patient-information/">Read our patient information</a> or{' '}
          <a href="/appointment-policy/">view the appointment policy</a>.
        </p>
      </div>
      <aside>
        <div class="sidebar-panel">
          <p class="eyebrow">Appointment information</p>
          <h2>{service.name}</h2>
          <p class="price-amount">
            {service.slug === 'other-vascular' ? 'From ' : ''}${service.price}
          </p>
          {service.priceNote && <p class="small">{service.priceNote}</p>}
          {service.pregnancyEligible && (
            <p class="small">
              For eligible NZ maternity patients. Eligible pregnancy scans are
              $30 with a Community Services Card. Contact us about non-eligible
              pricing.
            </p>
          )}
          {service.enquire && (
            <p>Please check availability with reception before booking.</p>
          )}
          <a
            class="button"
            href={bookingUrl(service)}
            target={service.booking ? '_blank' : undefined}
            rel={service.booking ? 'noopener noreferrer' : undefined}
            data-event={service.booking ? 'book_online_click' : undefined}
          >
            {service.booking ? 'Book this scan' : 'Enquire about this scan'}{' '}
            <span aria-hidden="true">↗</span>
          </a>
          {service.booking && (
            <p class="small" style="margin-top:1rem">
              Opens our secure TidyCal booking page in a new tab.
            </p>
          )}
          <p style="margin-top:1rem">
            <a href={site.tel} data-event="phone_click">
              Call {site.phone}
            </a>
          </p>
          <a class="small" href="/pricing/">
            View all pricing and payment details
          </a>
        </div>
      </aside>
    </div>
  </section>
  <section class="section-tight mist">
    <div class="container split split-top">
      <div>
        <h2>Related services</h2>
        <div class="related-list">
          {related.map((s) => (
            <a class="exam-link" href={serviceUrl(s)}>
              <div>
                <h3>{s.name}</h3>
                <p>
                  {s.slug === 'other-vascular' ? 'From ' : ''}${s.price}
                </p>
              </div>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <p style="margin-top:1.5rem">
          <a href={`/services/${category.slug}/`}>
            All {category.short.toLowerCase()} scans
          </a>{' '}
          · <a href="/services/">All services</a>
        </p>
      </div>
      <div>
        <h2>Common questions</h2>
        <FAQ
          questions={[
            'Do I need a referral for an ultrasound?',
            'How long does an ultrasound examination take?',
            'When will my ultrasound report be available?',
            'Can I bring someone with me?',
          ]}
        />
      </div>
    </div>
  </section>
  <Callout />
</Layout>
