---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Photo from '../../../components/Photo.astro';
import Callout from '../../../components/Callout.astro';
import Icon from '../../../components/Icon.astro';
import {
  categories,
  services,
  serviceUrl,
  bookingUrl,
  preparation,
  nonEligibleMaternityPrice,
} from '../../../data/services';
import { images } from '../../../data/images';
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}
const { category } = Astro.props;
const exams = services.filter((s) => s.category === category.slug);
---

<Layout
  title={category.name}
  description={`${category.intro} View examination information, preparation and prices at Hobsonville Ultrasound.`}
>
  <section class="page-intro category-page-intro">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Services', href: '/services/' },
          { label: category.short },
        ]}
      />
      <div class="category-hero">
        <div>
          <p class="eyebrow">Our services</p>
          <h1>{category.name}</h1>
          <p class="lead">{category.intro}</p>
        </div>
        <Photo
          src={images[category.image]}
          alt={`Illustrative photograph for ${category.name.toLowerCase()}`}
          eager
        />
      </div>
    </div>
  </section>
  <section class="section service-category-page">
    <div class="container">
      <div class="section-heading">
        <h2>Find your examination.</h2>
        <p>{category.detail}</p>
      </div>
      <div class="category-booking-layout">
        <div class="category-examinations">
          {exams.map((s) => (
            <details class="category-exam" id={`exam-${s.slug}`}>
              <summary>
                <span>
                  <strong>{s.name}</strong>
                  {s.timing && (
                    <span class="category-exam-timing">{s.timing}</span>
                  )}
                </span>
                <span class="category-exam-toggle" aria-hidden="true"></span>
              </summary>
              <div class="category-exam-content">
                <p>{s.description}</p>
                {s.urgentNote && (
                  <p class="category-exam-urgent">{s.urgentNote}</p>
                )}
                <h3>Preparation</h3>
                <ul>
                  {preparation[s.prep]
                    .filter(
                      (_, index) =>
                        s.prep !== 'msk' ||
                        s.slug === 'shoulder' ||
                        index === 0,
                    )
                    .map((line) => (
                      <li>{line}</li>
                    ))}
                </ul>
                <p class="category-exam-price">
                  <strong>Price:</strong>{' '}
                  {s.slug === 'other-vascular' ? 'From ' : ''}${s.price}
                  {s.priceNote && s.slug !== 'other-vascular'
                    ? ` · ${s.priceNote}`
                    : ''}
                  {s.pregnancyEligible ? ' · eligible maternity patients' : ''}
                  {s.slug === 'other-vascular'
                    ? ' · confirm with reception'
                    : ''}
                </p>
                {s.category === 'musculoskeletal' && (
                  <p>
                    There is currently no patient charge for musculoskeletal
                    examinations with an ACC referral.
                  </p>
                )}
                <div class="category-exam-actions">
                  <a
                    class:list={[
                      'button',
                      {
                        'booking-button': s.booking,
                        'button-outline': !s.booking,
                      },
                    ]}
                    href={bookingUrl(s)}
                    target={s.booking ? '_blank' : undefined}
                    rel={s.booking ? 'noopener noreferrer' : undefined}
                    data-event={s.booking ? 'book_online_click' : undefined}
                  >
                    <Icon name={s.booking ? 'calendar' : 'mail'} size={20} />
                    {s.booking ? 'Book online' : 'Contact reception'}
                  </a>
                  <a class="text-link" href={serviceUrl(s)}>
                    More information <Icon name="arrow" size={18} />
                  </a>
                </div>
              </div>
            </details>
          ))}
          {category.slug === 'pregnancy' && (
            <div class="notice">
              <p>
                Listed diagnostic pregnancy prices apply to eligible New Zealand
                maternity patients. Eligible pregnancy scans are $30 with a
                Community Services Card. Diagnostic pregnancy scans for patients
                not eligible for NZ maternity funding cost $
                {nonEligibleMaternityPrice}. Contact reception to confirm
                eligibility.
              </p>
            </div>
          )}
        </div>
        <aside class="category-booking-aside">
          <div class="sidebar-panel">
            <h2>Your booking checklist</h2>
            <ul>
              <li>Have your referral ready for diagnostic scans.</li>
              <li>Check the preparation for your examination.</li>
              <li>Review the price and eligibility information.</li>
              <li>
                Contact reception if your scan is not listed or you need help
                choosing.
              </li>
            </ul>
            <p>
              <a href="/pricing/">View prices</a>
            </p>
            <p>
              <a href="/appointment-policy/">
                Cancellation and appointment policy
              </a>
            </p>
          </div>
        </aside>
      </div>
      <p style="margin-top:2rem">
        <a href="/pricing/">Full pricing and payment information</a> ·{' '}
        <a href="/patient-information/">Your appointment guide</a>
      </p>
    </div>
  </section>
  <Callout />
</Layout>
