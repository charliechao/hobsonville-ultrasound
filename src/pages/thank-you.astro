---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="Thank you"
  description="Thank you for choosing Hobsonville Ultrasound."
  noindex
>
  <section class="section">
    <div class="container reading">
      <p class="section-label">Hobsonville Ultrasound</p>
      <h1>Thank you</h1>
      <p class="lead">
        Thank you for choosing Hobsonville Ultrasound for your imaging needs.
      </p>
      <p>Your booking has been successfully received.</p>
      <p>
        Kindly email your referral form to{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <a class="button booking-button" href="/services/">
        Explore our services
      </a>
    </div>
  </section>
</Layout>
